<%@ page import="ui.ShoppingCartInfo" %>
<%
    ShoppingCartInfo cartInfo = (ShoppingCartInfo) request.getAttribute("cartInfo");
    String ctx = request.getContextPath();
%>
<header>
  <b>Webbshoppen</b>
  <a href="<%= ctx %>/shop">Butik</a>
  <a href="<%= ctx %>/cart">Kundvagn (<%= cartInfo.getItemCount() %>)</a>
  Inloggad som <%= session.getAttribute("username") %>
  <a href="<%= ctx %>/logout">Logga ut</a>
</header>
<hr>
